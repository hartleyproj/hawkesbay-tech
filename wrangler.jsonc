{
  // Static-assets Worker that serves the built site.
  // Deploying with this name updates the existing "hawkesbay-tech" Worker,
  // so the custom domains (hawkesbay.tech, www) stay attached.
  "name": "hawkesbay-tech",
  "compatibility_date": "2026-07-25",
  "assets": { "directory": "./public" }
}
